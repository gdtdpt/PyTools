<Window x:Class="PyTools.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PyTools.Core"
        Title="PyTools 设置"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg.Window}"
        ShowInTaskbar="True" Loaded="Window_Loaded">
    <!-- 设置窗口（M2b，L10）：普通窗 chrome，复用令牌层；双形态视觉一致。 -->
    <Window.Resources>
        <core:EmptyToVisibilityConverter x:Key="EmptyToVisible"/>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,16">

            <TextBlock Text="常规"
                       FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource Text.Primary}"
                       Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="主热键" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text.Secondary}"/>
                <TextBox x:Name="HotkeyBox" Grid.Column="1"
                         Height="28" Padding="6,0"
                         VerticalContentAlignment="Center"
                         IsReadOnly="True" IsReadOnlyCaretVisible="False"
                         Cursor="Hand"
                         GotKeyboardFocus="HotkeyBox_OnGotFocus"
                         LostKeyboardFocus="HotkeyBox_OnLostFocus"
                         PreviewKeyDown="HotkeyBox_OnPreviewKeyDown"
                         Foreground="{DynamicResource Text.Primary}"
                         CaretBrush="{DynamicResource Text.Primary}"
                         ToolTip="点击后按下新的组合键；Esc 取消"/>
            </Grid>
            <!-- 提示行常驻占位（不折叠）：避免状态文字出现/消失时推挤下方表单布局 -->
            <TextBlock x:Name="HotkeyHint" FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       Margin="130,2,0,0"/>

            <CheckBox x:Name="AutoStartCheck" Content="开机自启动"
                      Margin="0,4"
                      Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"/>
            <CheckBox x:Name="PinyinCheck" Content="拼音首字母搜索（输入 wx 命中「微信」）"
                      Margin="0,4"
                      Checked="OnPinyinChanged" Unchecked="OnPinyinChanged"/>
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Ctrl+N/P 翻页步进条数" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text.Secondary}"/>
                <TextBox x:Name="PageStepBox" Grid.Column="1" Height="26" Padding="6,0"
                         Width="70" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                         Margin="8,0,0,0"
                         ToolTip="按一次 Ctrl+N/P 移动的条数（1-20），回车或移开焦点生效"
                         Background="{DynamicResource Bg.Input}"
                         BorderBrush="{DynamicResource Border.Input}"
                         Foreground="{DynamicResource Text.Primary}"
                         LostFocus="OnPageStepCommitted" KeyDown="OnPageStepKeyDown"/>
            </Grid>
            <CheckBox x:Name="LiteModeCheck" Content="简洁模式（不透明方角、无动效；重启生效）"
                      Margin="0,4"
                      Checked="OnLiteModeChanged" Unchecked="OnLiteModeChanged"/>
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="呼出位置" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text.Secondary}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ResetPositionButton" Content="恢复默认位置"
                            Click="OnResetPosition"
                            ToolTip="清除位置记忆，下次呼出回到默认位（水平居中、垂直上 1/3）"/>
                    <TextBlock x:Name="PositionHint" Text="" VerticalAlignment="Center" Margin="12,0,0,0"
                               FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="剪贴板"
                       FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource Text.Primary}"
                       Margin="0,18,0,8"/>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="直呼热键" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text.Secondary}"/>
                <Grid Grid.Column="1">
                    <TextBox x:Name="ClipHotkeyBox"
                             Height="28" Padding="6,0"
                             VerticalContentAlignment="Center"
                             IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             Cursor="Hand"
                             GotKeyboardFocus="HotkeyBox_OnGotFocus"
                             LostKeyboardFocus="HotkeyBox_OnLostFocus"
                             PreviewKeyDown="HotkeyBox_OnPreviewKeyDown"
                             Background="{DynamicResource Bg.Input}"
                             BorderBrush="{DynamicResource Border.Input}"
                             Foreground="{DynamicResource Text.Primary}"
                             CaretBrush="{DynamicResource Text.Primary}"
                             ToolTip="点击后按下组合键；Win 组合请用右侧「Win+V」；Esc 取消"/>
                    <!-- 空值占位：叠加层，不新增行、不改变布局 -->
                    <TextBlock Text="未设置"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Placeholder}"
                               Visibility="{Binding Text, ElementName=ClipHotkeyBox, Converter={StaticResource EmptyToVisible}}"/>
                </Grid>
                <Button x:Name="ClipWinVButton" Grid.Column="2" Content="Win+V"
                        Margin="8,0,0,0" Click="OnClipWinV"/>
                <Button x:Name="ClipClearButton" Grid.Column="3" Content="清除"
                        Margin="6,0,0,0" Click="OnClipClear"/>
            </Grid>
            <!-- 提示行常驻占位（不折叠）：同上，任何状态都不推挤下方表单 -->
            <TextBlock x:Name="ClipHotkeyHint" FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       Margin="130,2,0,0" TextWrapping="Wrap"/>
            <CheckBox x:Name="ClipEnabledCheck" Content="启用剪贴板直呼热键"
                      Margin="0,4"
                      Checked="OnClipEnabledChanged" Unchecked="OnClipEnabledChanged"/>
            <CheckBox x:Name="PrivacyFilterCheck" Content="隐私格式过滤（跳过标记为不可监控的复制内容）"
                      Margin="0,4"
                      Checked="OnPrivacyFilterChanged" Unchecked="OnPrivacyFilterChanged"/>
            <TextBlock x:Name="PrivacyHint" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,0"/>

            <TextBlock Text="右键菜单"
                       FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource Text.Primary}"
                       Margin="0,18,0,8"/>
            <CheckBox x:Name="ContextMenuCheck" Content="在 exe / lnk 右键菜单显示「添加到 PyTools」"
                      Margin="0,4"
                      Checked="OnContextMenuChanged" Unchecked="OnContextMenuChanged"/>
            <!-- 提示行常驻占位（不折叠）：同上，保持布局稳定 -->
            <TextBlock x:Name="ContextMenuHint" FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,0"/>

            <TextBlock Text="应用登记"
                       FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource Text.Primary}"
                       Margin="0,18,0,8"/>
            <Grid MinHeight="120" MaxHeight="240">
                <ListBox x:Name="CustomList"
                         Background="{DynamicResource Bg.Input}"
                         BorderBrush="{DynamicResource Border.Input}"
                         Foreground="{DynamicResource Text.Primary}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,2">
                                <TextBlock Text="{Binding Key}" FontWeight="Bold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Value}"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="CustomEmptyHint"
                           Text="暂无登记（在 exe / lnk 右键选择「添加到 PyTools」）"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" IsHitTestVisible="False"
                           Foreground="{DynamicResource Text.Secondary}"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="RemoveCustomButton" Content="移除选中登记"
                        Click="OnRemoveCustom"/>
                <Button x:Name="OpenCustomFolderButton" Content="打开所在目录" Margin="8,0,0,0"
                        Click="OnOpenCustomFolder"/>
                <TextBlock x:Name="CustomHint" Text="" VerticalAlignment="Center" Margin="12,0,0,0"
                           FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="关闭" Padding="16,0" Click="OnClose"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
