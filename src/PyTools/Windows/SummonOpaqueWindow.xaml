<local:SummonWindowBase x:Class="PyTools.Windows.SummonOpaqueWindow"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:local="clr-namespace:PyTools.Windows"
                        xmlns:views="clr-namespace:PyTools.Views"
                        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                        Background="{DynamicResource Bg.Window}"
                        Title="PyTools.Summon"
                        ShowInTaskbar="False">
    <!-- 简洁形态壳：不透明方角，DWM 阴影（GlassFrameThickness=-1），无软件合成开销 -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      CaptionHeight="0"
                      CornerRadius="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <views:SummonView/>
</local:SummonWindowBase>
