<UserControl x:Class="PyTools.Views.CronView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PyTools.Views">
    <!-- Cron 表达式视图（M4）：表达式栏 + 状态行 + 双栏构造器（左秒分时/右日月周）+ 摘要 + 最近触发。
         首个使用「工具固定尺寸模式」的视图：进入时窗口动画放大（App 层通用机制，v1 同参数 180ms 三次缓出）。
         构造器行在代码后置构建（6 行 × 4 模式参数面板，XAML 写不下）；键位照全局约定。 -->
    <Border x:Name="RootBorder"
            Background="{DynamicResource Bg.Window}"
            BorderBrush="{DynamicResource Border.Window}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Window}"
            Effect="{DynamicResource Fx.WindowShadow}">
        <!-- ContentGrid 满幅承载圆角 Clip（与其他视图同构）；内容边距放内层 -->
        <Grid x:Name="ContentGrid">
            <Grid Margin="12,14,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 表达式栏 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="表达式" VerticalAlignment="Center" Margin="0,0,6,0"
                               FontSize="{DynamicResource Font.Secondary}"
                               Foreground="{DynamicResource Text.Secondary}"/>
                    <TextBox x:Name="ExprBox" Grid.Column="1"
                             Height="30"
                             FontFamily="Consolas"
                             FontSize="{DynamicResource Font.Base}"
                             Foreground="{DynamicResource Text.Primary}"
                             Background="{DynamicResource Bg.Input}"
                             BorderBrush="{DynamicResource Border.Input}"
                             BorderThickness="1"
                             Padding="8,5"
                             VerticalContentAlignment="Center"
                             SpellCheck.IsEnabled="False"
                             TextChanged="OnExprChanged"
                             CaretBrush="{DynamicResource Text.Primary}"/>
                    <Button x:Name="CopyButton" Grid.Column="2" Content="复制" Margin="8,0,0,0"
                            Padding="12,0" Height="30" Click="OnCopyClick"/>
                </Grid>

                <!-- 状态行：左 = 解析状态；右 = 操作键帽 -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0"
                               Text="输入表达式，或在构造器里点选"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource Font.Secondary}"
                               Foreground="{DynamicResource Text.Placeholder}"
                               TextTrimming="CharacterEllipsis"/>
                    <Border x:Name="ActionsHint" Grid.Column="1"
                            Background="{DynamicResource Bg.ItemHover}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="8,3" Margin="8,0,0,0" Cursor="Hand">
                        <TextBlock Text="操作 Ctrl+Enter"
                                   FontSize="{DynamicResource Font.Secondary}"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                    </Border>
                </Grid>

                <!-- 双栏构造器（左秒分时 / 右日月周），行在代码后置构建 -->
                <Grid x:Name="BuilderHost" Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="LeftColumn" Grid.Column="0"/>
                    <StackPanel x:Name="RightColumn" Grid.Column="2"/>
                </Grid>

                <!-- 摘要（中文人话描述） -->
                <TextBlock x:Name="SummaryText" Grid.Row="3" Text="等待输入" Margin="0,10,0,0"
                           FontSize="{DynamicResource Font.Base}"
                           Foreground="{DynamicResource Text.Primary}"
                           TextTrimming="CharacterEllipsis"/>

                <!-- 最近触发标题 + 条数 -->
                <Grid Grid.Row="4" Margin="0,8,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="最近触发" VerticalAlignment="Center"
                               FontSize="{DynamicResource Font.Secondary}"
                               Foreground="{DynamicResource Text.Secondary}"/>
                    <ComboBox x:Name="CountBox" Grid.Column="1" Width="72" Height="24"
                              FontSize="{DynamicResource Font.Secondary}"
                              SelectionChanged="OnCountChanged">
                        <ComboBoxItem Content="5 条" IsSelected="True"/>
                        <ComboBoxItem Content="10 条"/>
                        <ComboBoxItem Content="20 条"/>
                    </ComboBox>
                </Grid>

                <!-- 最近触发列表 -->
                <ScrollViewer x:Name="RunsScroll" Grid.Row="5"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="RunsList"/>
                </ScrollViewer>

                <!-- 日/周「或」规则提示 -->
                <TextBlock x:Name="OrRuleNote" Grid.Row="6" Margin="0,6,0,0"
                           Text="日字段与周字段同时限定时按「或」触发：命中任一条件即触发，不是必须同时满足。"
                           FontSize="{DynamicResource Font.Secondary}"
                           Foreground="{DynamicResource Text.Placeholder}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <!-- 动作面板（独立浮层组件） -->
                <views:ActionPanel x:Name="Actions"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
