<UserControl x:Class="PyTools.Views.RegexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PyTools.Views">
    <!-- 正则测试视图（M4，T5）：左测试文本 + 右三块结果同屏（匹配列表/全文高亮/替换结果，2026-11-04 方案 A 拍板）。
         工具固定尺寸模式（860×620，App 层通用机制）；标志位 4 个 CheckBox（g 默认开）；
         匹配列表点选联动：滚动定位 + 闪烁标注（v1 没有的增强）。AI 生成暂缓（AI 批首个补上）。
         键位照全局约定：Ctrl+Enter 动作面板 / Esc 由窗口级路由。 -->
    <Border x:Name="RootBorder"
            Background="{DynamicResource Bg.Window}"
            BorderBrush="{DynamicResource Border.Window}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Window}"
            Effect="{DynamicResource Fx.WindowShadow}">
        <!-- ContentGrid 满幅承载圆角 Clip（与其他视图同构）；内容边距放内层 -->
        <Grid x:Name="ContentGrid">
            <Grid Margin="12,14,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 表达式栏 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="表达式" VerticalAlignment="Center" Margin="0,0,6,0"
                               FontSize="{DynamicResource Font.Secondary}"
                               Foreground="{DynamicResource Text.Secondary}"/>
                    <!-- 与 cron ExprBox 同口径：单行框 Padding 6,0、字号 15（光标高度 = 字号×行距，14px Consolas 太短） -->
                    <TextBox x:Name="ExprBox" Grid.Column="1"
                             Height="30"
                             FontFamily="Consolas"
                             FontSize="15"
                             BorderThickness="1"
                             Padding="6,0,6,0"
                             VerticalContentAlignment="Center"
                             SpellCheck.IsEnabled="False"
                             TextChanged="OnInputChanged"/>
                </Grid>

                <!-- 替换串栏 -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="替换为" VerticalAlignment="Center" Margin="0,0,6,0"
                               FontSize="{DynamicResource Font.Secondary}"
                               Foreground="{DynamicResource Text.Secondary}"/>
                    <TextBox x:Name="ReplaceBox" Grid.Column="1"
                             Height="28"
                             FontFamily="Consolas"
                             FontSize="14"
                             BorderThickness="1"
                             Padding="6,0,6,0"
                             VerticalContentAlignment="Center"
                             SpellCheck.IsEnabled="False"
                             TextChanged="OnInputChanged"/>
                    <TextBlock Grid.Column="2" Text="$1 = 第 1 组，${name} = 命名组" VerticalAlignment="Center" Margin="10,0,0,0"
                               FontSize="{DynamicResource Font.Secondary}"
                               Foreground="{DynamicResource Text.Placeholder}"/>
                </Grid>

                <!-- 标志位行：4 个 CheckBox（v1 同款，g 默认开）。XAML IsChecked 触发 Checked 时兄弟未构造，处理里加 null 守卫 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox x:Name="FlagGlobal" Content="全局 (g)" IsChecked="True"
                              Margin="0,0,14,0" Checked="OnInputChanged" Unchecked="OnInputChanged"
                              ToolTip="列出全部匹配并替换所有；去掉只取/只替换第一处"/>
                    <CheckBox x:Name="FlagIgnoreCase" Content="忽略大小写 (i)"
                              Margin="0,0,14,0" Checked="OnInputChanged" Unchecked="OnInputChanged"/>
                    <CheckBox x:Name="FlagMultiline" Content="多行 (m)"
                              Margin="0,0,14,0" Checked="OnInputChanged" Unchecked="OnInputChanged"
                              ToolTip="^ $ 匹配每一行的行首行尾"/>
                    <CheckBox x:Name="FlagDotAll" Content="点号跨行 (s)"
                              Margin="0,0,14,0" Checked="OnInputChanged" Unchecked="OnInputChanged"
                              ToolTip=". 匹配换行符"/>
                </StackPanel>

                <!-- 主体：左测试文本 / 右三块结果 -->
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*" MinWidth="240"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="8*" MinWidth="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：测试文本 -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="测试文本" Margin="0,0,0,4"
                                   FontSize="{DynamicResource Font.Secondary}"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                        <TextBox x:Name="TestBox" Grid.Row="1"
                                 AcceptsReturn="True"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 Padding="6,4,6,4"
                                 SpellCheck.IsEnabled="False"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 TextChanged="OnInputChanged"/>
                    </Grid>

                    <!-- 右：匹配列表 / 全文高亮 / 替换结果 三块同屏 -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1.2*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="匹配" Margin="0,0,0,4"
                                   FontSize="{DynamicResource Font.Secondary}"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="MatchList"/>
                        </ScrollViewer>

                        <TextBlock Grid.Row="2" Text="高亮" Margin="0,8,0,4"
                                   FontSize="{DynamicResource Font.Secondary}"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                        <Border Grid.Row="3"
                                Background="{DynamicResource Bg.Input}"
                                BorderBrush="{DynamicResource Border.Input}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Control}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Padding="6,4,6,4">
                                <TextBlock x:Name="HighlightText" TextWrapping="Wrap"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="{DynamicResource Text.Primary}"/>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Grid.Row="4" Text="替换结果" Margin="0,8,0,4"
                                   FontSize="{DynamicResource Font.Secondary}"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                        <Border Grid.Row="5"
                                Background="{DynamicResource Bg.Input}"
                                BorderBrush="{DynamicResource Border.Input}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Control}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Padding="6,4,6,4">
                                <TextBlock x:Name="ReplaceResult" TextWrapping="Wrap"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="{DynamicResource Text.Primary}"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 状态栏：左 = 匹配 N 条 / 错误原因；右 = 操作键帽 -->
                <Grid Grid.Row="4" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0"
                               Text="等待输入正则"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource Font.Secondary}"
                               Foreground="{DynamicResource Text.Placeholder}"
                               TextTrimming="CharacterEllipsis"/>
                    <Border x:Name="ActionsHint" Grid.Column="1"
                            Background="{DynamicResource Bg.ItemHover}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="8,3" Margin="8,0,0,0" Cursor="Hand">
                        <TextBlock Text="操作 Ctrl+Enter"
                                   FontSize="{DynamicResource Font.Secondary}"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                    </Border>
                </Grid>

                <!-- 动作面板（独立浮层组件） -->
                <views:ActionPanel x:Name="Actions"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
