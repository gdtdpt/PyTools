<UserControl x:Class="PyTools.Views.TranslateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PyTools.Views">
    <!-- AI 翻译视图（M4 AI 批第三个消费者）：语言条（源/目标 + 互换）→ 左右双栏（原文/译文，均可编辑）→ 状态栏。
         壳内固定尺寸模式（900×620，App 层通用机制）。源语言「自动」时单次请求由模型自判（回 detectedLang），
         不再像 v1 先发一次 detect 请求。键位照全局约定：Ctrl+Enter 动作面板 / Esc 由窗口级路由；
         源栏 Enter = 换行（多行输入），翻译走主按钮或动作面板。 -->
    <Border x:Name="RootBorder"
            Background="{DynamicResource Bg.Window}"
            BorderBrush="{DynamicResource Border.Window}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Window}"
            Effect="{DynamicResource Fx.WindowShadow}">
        <Grid x:Name="ContentGrid">
            <Grid Margin="12,14,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 语言条：源语言 ⇄ 目标语言，右侧主按钮 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="源语言" VerticalAlignment="Center" Margin="0,0,6,0"
                               FontSize="{DynamicResource Font.Secondary}"
                               Foreground="{DynamicResource Text.Secondary}"/>
                    <ComboBox x:Name="SourceLangBox" Grid.Column="1" Width="104" Height="26"
                              FontSize="{DynamicResource Font.Secondary}"
                              SelectionChanged="OnLangChanged">
                        <ComboBoxItem Content="自动检测" Tag="" IsSelected="True"/>
                        <ComboBoxItem Content="中文" Tag="zh-CN"/>
                        <ComboBoxItem Content="英文" Tag="en"/>
                        <ComboBoxItem Content="日文" Tag="ja"/>
                    </ComboBox>

                    <!-- 互换：矢量双箭头（不用字体字形，避免缺字/裁切），hover 反色由默认按钮样式接管 -->
                    <Button x:Name="SwapButton" Grid.Column="2" Width="32" Height="26" Margin="8,0,8,0"
                            Padding="0" Focusable="True"
                            ToolTip="互换源语言与目标语言（有译文时一并换到原文栏）"
                            Click="OnSwapClick">
                        <Path Width="16" Height="14" Stretch="None"
                              Stroke="{DynamicResource Text.Secondary}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M1,4 L15,4 M11,1 L15,4 L11,7 M15,10 L1,10 M5,7 L1,10 L5,13">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource Text.Primary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <TextBlock Grid.Column="3" Text="目标语言" VerticalAlignment="Center" Margin="0,0,6,0"
                               FontSize="{DynamicResource Font.Secondary}"
                               Foreground="{DynamicResource Text.Secondary}"/>
                    <ComboBox x:Name="TargetLangBox" Grid.Column="4" Width="104" Height="26"
                              FontSize="{DynamicResource Font.Secondary}"
                              SelectionChanged="OnLangChanged">
                        <ComboBoxItem Content="中文" Tag="zh-CN" IsSelected="True"/>
                        <ComboBoxItem Content="英文" Tag="en"/>
                        <ComboBoxItem Content="日文" Tag="ja"/>
                    </ComboBox>

                    <Button x:Name="TranslateButton" Grid.Column="6" Content="翻译"
                            Style="{StaticResource AccentButton}"
                            MinWidth="86" Height="28"
                            Click="OnTranslateClick"/>
                </Grid>

                <!-- 双栏：左原文 / 右译文（都可编辑） -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.15*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Border Background="{DynamicResource Bg.Input}"
                                BorderBrush="{DynamicResource Border.Input}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Control}">
                            <TextBox x:Name="SourceBox"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas, Microsoft YaHei UI"
                                     FontSize="13"
                                     Padding="8,6,8,6"
                                     SpellCheck.IsEnabled="False"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     TextChanged="OnSourceTextChanged"
                                     GotKeyboardFocus="OnSourceFocusChanged"
                                     LostKeyboardFocus="OnSourceFocusChanged"/>
                        </Border>
                        <TextBlock x:Name="SourcePlaceholder"
                                   Text="在此输入或粘贴要翻译的文本（Ctrl+V）"
                                   Margin="12,8,12,8"
                                   FontSize="{DynamicResource Font.Base}"
                                   Foreground="{DynamicResource Text.Placeholder}"
                                   IsHitTestVisible="False"
                                   TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Border Background="{DynamicResource Bg.Input}"
                                BorderBrush="{DynamicResource Border.Input}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Control}">
                            <TextBox x:Name="ResultBox"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas, Microsoft YaHei UI"
                                     FontSize="13"
                                     Padding="8,6,8,6"
                                     SpellCheck.IsEnabled="False"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     TextChanged="OnResultTextChanged"
                                     GotKeyboardFocus="OnResultFocusChanged"
                                     LostKeyboardFocus="OnResultFocusChanged"/>
                        </Border>
                        <TextBlock x:Name="ResultPlaceholder"
                                   Text="译文将显示在这里，可直接修改后复制"
                                   Margin="12,8,12,8"
                                   FontSize="{DynamicResource Font.Base}"
                                   Foreground="{DynamicResource Text.Placeholder}"
                                   IsHitTestVisible="False"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Grid>

                <!-- 状态栏：左 = 生命周期文案；右 = 操作键帽 -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0"
                               Text="等待输入文本"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource Font.Secondary}"
                               Foreground="{DynamicResource Text.Placeholder}"
                               TextTrimming="CharacterEllipsis"/>
                    <Border x:Name="ActionsHint" Grid.Column="1"
                            Background="{DynamicResource Bg.ItemHover}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="8,3" Margin="8,0,0,0" Cursor="Hand">
                        <TextBlock Text="操作 Ctrl+Enter"
                                   FontSize="{DynamicResource Font.Secondary}"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                    </Border>
                </Grid>

                <!-- 动作面板（独立浮层组件） -->
                <views:ActionPanel x:Name="Actions"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
