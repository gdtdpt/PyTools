<UserControl x:Class="PyTools.Views.FormatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PyTools.Views">
    <!-- 格式化视图（M4）：首个非列表型工具视图。工具栏 + 等宽编辑区 + 状态栏，固定高。
         键位照全局约定：Ctrl+Enter 动作面板、Esc 回启动器空态（窗口级隧道）。 -->
    <Border x:Name="RootBorder"
            Background="{DynamicResource Bg.Window}"
            BorderBrush="{DynamicResource Border.Window}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Window}"
            Effect="{DynamicResource Fx.WindowShadow}">
        <!-- ContentGrid 满幅承载圆角 Clip（与其他视图同构）；内容边距放内层，
             否则 Clip 相对 Grid 原点生效、外边距不在裁切区内，角落内容会被圆角削掉 -->
        <Grid x:Name="ContentGrid">
            <Grid Margin="12,14,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 操作按钮行 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="FormatClipboardButton" Content="格式化剪贴板" Click="OnFormatClipboard"
                        ToolTip="读取剪贴板，自动识别 JSON/XML 格式化后写回"/>
                <Button x:Name="FormatInputButton" Content="格式化输入" Margin="6,0,0,0" Click="OnFormatInput"/>
                <Button x:Name="MinifyButton" Content="压缩" Margin="6,0,0,0" Click="OnMinify"/>
                <Button x:Name="CopyButton" Content="复制结果" Margin="6,0,0,0" Click="OnCopy"/>
                <Button x:Name="UndoButton" Content="撤销" Margin="6,0,0,0" Click="OnUndo" IsEnabled="False"
                        ToolTip="恢复上次处理前的内容"/>
            </StackPanel>

            <!-- 选项行：格式 + 缩进（控件外观由 Themes/Controls.xaml 隐式样式统一） -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="格式" VerticalAlignment="Center" Margin="0,0,6,0"
                           FontSize="{DynamicResource Font.Secondary}"
                           Foreground="{DynamicResource Text.Secondary}"/>
                <RadioButton x:Name="FormatAutoRadio" GroupName="fmtFormat" Content="自动" IsChecked="True"
                             Margin="0,0,8,0" Checked="OnOptionChanged"/>
                <RadioButton x:Name="FormatJsonRadio" GroupName="fmtFormat" Content="JSON"
                             Margin="0,0,8,0" Checked="OnOptionChanged"/>
                <RadioButton x:Name="FormatXmlRadio" GroupName="fmtFormat" Content="XML"
                             Margin="0,0,14,0" Checked="OnOptionChanged"/>
                <TextBlock Text="缩进" VerticalAlignment="Center" Margin="0,0,6,0"
                           FontSize="{DynamicResource Font.Secondary}"
                           Foreground="{DynamicResource Text.Secondary}"/>
                <RadioButton x:Name="Indent2Radio" GroupName="fmtIndent" Content="2 空格" IsChecked="True"
                             Margin="0,0,8,0"/>
                <RadioButton x:Name="Indent4Radio" GroupName="fmtIndent" Content="4 空格"
                             Margin="0,0,8,0"/>
                <RadioButton x:Name="IndentTabRadio" GroupName="fmtIndent" Content="Tab"/>
            </StackPanel>

            <!-- 等宽编辑区 -->
            <TextBox x:Name="Editor" Grid.Row="2"
                     Height="330"
                     FontFamily="Consolas"
                     FontSize="{DynamicResource Font.Base}"
                     Foreground="{DynamicResource Text.Primary}"
                     BorderThickness="1"
                     Padding="8,6"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextChanged="OnEditorChanged"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     SpellCheck.IsEnabled="False"
                     CaretBrush="{DynamicResource Text.Primary}"/>

            <!-- 状态栏：左 = 处理状态/默认提示；右 = 操作键帽（可点呼出动作面板） -->
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0"
                           Text="Ctrl+Enter 操作 · Esc 返回启动器"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource Font.Secondary}"
                           Foreground="{DynamicResource Text.Placeholder}"
                           TextTrimming="CharacterEllipsis"/>
                <Border x:Name="ActionsHint" Grid.Column="1"
                        Background="{DynamicResource Bg.ItemHover}"
                        CornerRadius="{DynamicResource Radius.Control}"
                        Padding="8,3" Margin="8,0,0,0" Cursor="Hand">
                    <TextBlock Text="操作 Ctrl+Enter"
                               FontSize="{DynamicResource Font.Secondary}"
                               Foreground="{DynamicResource Text.Secondary}"/>
                </Border>
            </Grid>

            <!-- 动作面板（独立浮层组件）：贴窗定位，可伸出窗外，上限 5 行 -->
            <views:ActionPanel x:Name="Actions"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
