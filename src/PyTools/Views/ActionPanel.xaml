<UserControl x:Class="PyTools.Views.ActionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:PyTools.Core">
    <!-- 动作面板（Raycast 式）：独立 Popup 浮层，可伸出窗外，高度与宿主列表无关——
         上限 5 行、超出走内部滚动条；自带过滤输入框（宿主搜索框不被复用）。
         宿主只需 Show(anchor, items)，面板自己管过滤/导航/单键提示/定位；
         执行通过 Invoked(id) 回到宿主，Esc/Tab 通过 Dismissed 通知宿主退出动作态。 -->
    <UserControl.Resources>
        <core:EmptyToVisibilityConverter x:Key="EmptyToVisible"/>
    </UserControl.Resources>
    <Popup x:Name="PART_Popup"
           AllowsTransparency="True"
           StaysOpen="True"
           Focusable="False"
           PopupAnimation="None"
           Placement="RelativePoint">
        <Border x:Name="Card"
                Width="300"
                Background="{DynamicResource Bg.Input}"
                BorderBrush="{DynamicResource Border.Input}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Control}"
                Effect="{DynamicResource Fx.WindowShadow}">
            <StackPanel>
                <!-- 行高 28 × 5 行 + Padding 6 = 146：最多同时 5 行，第 6 行起内部滚动 -->
                <ListBox x:Name="PART_Actions"
                         MaxHeight="146"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="3"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                CornerRadius="{DynamicResource Radius.Control}"
                                                Margin="1,0">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.ItemHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.ItemSelected}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <!-- 紧凑单行：标题 + 行尾提示键（无描述行） -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,3" MinHeight="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Title}"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource Font.Base}"
                                           Foreground="{DynamicResource Text.Primary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Bg.ItemHover}"
                                        BorderBrush="{DynamicResource Border.Input}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="5,0"
                                        Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Hint}"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               FontSize="{DynamicResource Font.Secondary}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="NoActionHint"
                           Text="没有匹配的操作"
                           Margin="14,10"
                           Foreground="{DynamicResource Text.Secondary}"
                           FontSize="{DynamicResource Font.Secondary}"
                           Visibility="Collapsed"/>
                <!-- 独立动作过滤输入：焦点随面板进出，宿主搜索框全程不被复用 -->
                <Border Margin="6,2,6,6"
                        Background="{DynamicResource Bg.ItemHover}"
                        CornerRadius="{DynamicResource Radius.Control}">
                    <Grid>
                        <TextBlock Text="搜索操作…"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource Text.Placeholder}"
                                   FontSize="{DynamicResource Font.Secondary}"
                                   Visibility="{Binding Text, ElementName=PART_ActionFilter, Converter={StaticResource EmptyToVisible}}"/>
                        <TextBox x:Name="PART_ActionFilter"
                                 Height="26"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="8,3"
                                 Margin="2,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="{DynamicResource Font.Secondary}"
                                 Foreground="{DynamicResource Text.Primary}"
                                 CaretBrush="{DynamicResource Text.Primary}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Popup>
</UserControl>
