<Window x:Class="PyTools.Views.OcrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PyTools.Views"
        Title="图片文字识别"
        Width="900" Height="620" MinWidth="720" MinHeight="460"
        Background="{DynamicResource Bg.Window}"
        WindowStartupLocation="Manual"
        AllowDrop="True" DragOver="OnWindowDragOver" Drop="OnWindowDrop"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp">
    <!--
      图片文字识别（M4 AI 批第二个消费者）：**独立常驻窗口**（与 diff 同族，2026-11-05 拍板）。
      理由：拖拽要先把资源管理器激活，寄居呼出壳会失焦即收；编辑结果也需要窗口留住。
      布局：左「图片卡 + AI 信息卡」/ 右「可编辑结果」。识别时图片卡缩成 120×90 让位，
      hover 缩略卡用气泡看原图，单击缩略卡恢复双栏。图片列 Auto 宽 + 改卡片 Width 即布局动画。
    -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Grid Grid.Row="0" Margin="14,12,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="PasteButton" Content="读取剪贴板图片" Click="OnReadClipboardClick"
                        ToolTip="从剪贴板读取图片（截图后直接点这里，或按 Ctrl+V）"/>
                <Button x:Name="FileButton" Content="选择本地图片" Margin="6,0,0,0" Click="OnChooseFileClick"
                        ToolTip="打开文件选择框（png / jpg / jpeg / bmp，≤10MB）"/>
                <Button x:Name="RecognizeButton" Content="识别" Margin="10,0,0,0" Click="OnRecognizeClick"
                        Style="{StaticResource AccentButton}"
                        ToolTip="调用 AI 识别图片中的文字（Ctrl+R）"/>
                <Button x:Name="ClearButton" Content="清空" Margin="6,0,0,0" Click="OnClearClick"
                        ToolTip="清空图片与识别结果，回到初始状态"/>
            </StackPanel>
            <TextBlock x:Name="ToolbarHint" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                       FontSize="{DynamicResource Font.Secondary}"
                       Foreground="{DynamicResource Text.Placeholder}"
                       TextTrimming="CharacterEllipsis" MaxWidth="260"/>
        </Grid>

        <!-- 主体：左图片 + AI 信息卡 / 右可编辑结果 -->
        <Grid x:Name="Body" Grid.Row="1" Margin="14,12,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="LeftPane" Grid.Column="0" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 图片卡：展开态撑满左列，识别后动画到 120×90 缩略卡（单击恢复双栏） -->
                <Border x:Name="ImageCard" Grid.Row="0"
                        Width="360" Height="420"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="{DynamicResource Bg.Input}"
                        BorderBrush="{DynamicResource Border.Input}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Control}"
                        Cursor="Hand"
                        MouseLeftButtonUp="OnImageCardClick">
                    <Grid x:Name="CardHost" ClipToBounds="True">
                        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="1"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="EmptyHint"
                                   Text="拖入图片 / Ctrl+V 粘贴 / 点击此处选择文件"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="24,0,24,0"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource Font.Secondary}"
                                   Foreground="{DynamicResource Text.Placeholder}"/>
                        <!-- 缩略态蒙层提示：告诉用户点一下能看大图（hover 气泡另给原图） -->
                        <Border x:Name="ThumbHint" Visibility="Collapsed"
                                VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                Background="#99000000" Padding="0,3">
                            <TextBlock Text="单击展开" HorizontalAlignment="Center"
                                       FontSize="10" Foreground="{DynamicResource Text.OnToast}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- AI 结果信息卡：识别生命周期只在这里呈现（状态栏只管通用操作反馈） -->
                <Border x:Name="InfoCard" Grid.Row="1" MinWidth="200" Margin="0,10,0,0"
                        Background="{DynamicResource Bg.Input}"
                        BorderBrush="{DynamicResource Border.Input}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Control}"
                        Padding="10,8,10,8">
                    <StackPanel>
                        <TextBlock Text="AI 识别" FontSize="11"
                                   Foreground="{DynamicResource Text.Placeholder}"/>
                        <TextBlock x:Name="InfoTitle" Text="等待图片" Margin="0,4,0,0"
                                   FontSize="{DynamicResource Font.Secondary}"
                                   Foreground="{DynamicResource Text.Primary}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="InfoDetail" Margin="0,3,0,0" TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 右侧结果区（可编辑） -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="识别结果" FontSize="{DynamicResource Font.Secondary}"
                               Foreground="{DynamicResource Text.Secondary}"/>
                    <TextBlock x:Name="ResultMeta" HorizontalAlignment="Right"
                               FontSize="11" Foreground="{DynamicResource Text.Placeholder}"/>
                </Grid>
                <Grid Grid.Row="1">
                    <TextBox x:Name="ResultBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas, Microsoft YaHei UI"
                             FontSize="13"
                             Padding="8,6,8,6"
                             SpellCheck.IsEnabled="False"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             GotKeyboardFocus="OnResultBoxFocusChanged"
                             LostKeyboardFocus="OnResultBoxFocusChanged"
                             TextChanged="OnResultTextChanged"/>
                    <TextBlock x:Name="ResultPlaceholder" IsHitTestVisible="False"
                               Text="识别结果将显示在这里，可直接修改后复制"
                               Margin="11,8,11,0"
                               VerticalAlignment="Top"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource Font.Secondary}"
                               Foreground="{DynamicResource Text.Placeholder}"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- 状态栏：左 = 通用操作反馈（AI 生命周期在信息卡，不重复）｜右 = 操作键帽 -->
        <Grid Grid.Row="2" Margin="14,8,14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0"
                       Text="等待图片"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource Font.Secondary}"
                       Foreground="{DynamicResource Text.Placeholder}"
                       TextTrimming="CharacterEllipsis"/>
            <Border x:Name="ActionsHint" Grid.Column="1"
                    Background="{DynamicResource Bg.ItemHover}"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Padding="8,3" Margin="8,0,0,0" Cursor="Hand">
                <TextBlock Text="操作 Ctrl+Enter"
                           FontSize="{DynamicResource Font.Secondary}"
                           Foreground="{DynamicResource Text.Secondary}"/>
            </Border>
        </Grid>

        <views:ActionPanel x:Name="Actions"/>
    </Grid>
</Window>
