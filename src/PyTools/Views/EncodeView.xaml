<UserControl x:Class="PyTools.Views.EncodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PyTools.Views">
    <!-- 编码转换视图（M4）：工具栏（格式/方向单选，方向随格式联动出提示）+ 上下堆叠双栏编辑区 + 状态栏。
         进入时预填剪贴板并立即转换（2026-11-02 用户提议拍板）；键位照全局约定。 -->
    <Border x:Name="RootBorder"
            Background="{DynamicResource Bg.Window}"
            BorderBrush="{DynamicResource Border.Window}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Window}"
            Effect="{DynamicResource Fx.WindowShadow}">
        <!-- ContentGrid 满幅承载圆角 Clip（与其他视图同构）；内容边距放内层 -->
        <Grid x:Name="ContentGrid">
            <Grid Margin="12,14,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 格式选择行 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="格式" VerticalAlignment="Center" Margin="0,0,6,0"
                               FontSize="{DynamicResource Font.Secondary}"
                               Foreground="{DynamicResource Text.Secondary}"/>
                    <RadioButton x:Name="FormatUrlRadio" GroupName="encFormat" Content="URL" Tag="url" IsChecked="True"
                                 Margin="0,0,8,0" Checked="OnOptionChanged"/>
                    <RadioButton x:Name="FormatBase64Radio" GroupName="encFormat" Content="Base64" Tag="base64"
                                 Margin="0,0,8,0" Checked="OnOptionChanged"/>
                    <RadioButton x:Name="FormatUnicodeRadio" GroupName="encFormat" Content="Unicode" Tag="unicode"
                                 Margin="0,0,8,0" Checked="OnOptionChanged"/>
                    <RadioButton x:Name="FormatHtmlRadio" GroupName="encFormat" Content="HTML 实体" Tag="html"
                                 Margin="0,0,8,0" Checked="OnOptionChanged"/>
                    <RadioButton x:Name="FormatJsonRadio" GroupName="encFormat" Content="JSON" Tag="json"
                                 Margin="0,0,8,0" Checked="OnOptionChanged"/>
                    <RadioButton x:Name="FormatHexRadio" GroupName="encFormat" Content="Hex" Tag="hex"
                                 Checked="OnOptionChanged"/>
                </StackPanel>

                <!-- 方向选择行 + 方向示例提示（v1 下拉的选项文案） -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="方向" VerticalAlignment="Center" Margin="0,0,6,0"
                               FontSize="{DynamicResource Font.Secondary}"
                               Foreground="{DynamicResource Text.Secondary}"/>
                    <RadioButton x:Name="DirectionEncodeRadio" GroupName="encDirection" Content="编码" Tag="encode" IsChecked="True"
                                 Margin="0,0,8,0" Checked="OnOptionChanged"/>
                    <RadioButton x:Name="DirectionDecodeRadio" GroupName="encDirection" Content="解码" Tag="decode"
                                 Margin="0,0,10,0" Checked="OnOptionChanged"/>
                    <TextBlock x:Name="DirectionHint" Text="" VerticalAlignment="Center"
                               FontSize="{DynamicResource Font.Secondary}"
                               Foreground="{DynamicResource Text.Placeholder}"/>
                </StackPanel>

                <!-- 输入区（可编辑） -->
                <TextBox x:Name="InputBox" Grid.Row="2"
                         Height="150"
                         FontFamily="Consolas"
                         FontSize="{DynamicResource Font.Base}"
                         Foreground="{DynamicResource Text.Primary}"
                         BorderThickness="1"
                         Padding="8,6"
                         AcceptsReturn="True"
                         TextChanged="OnInputChanged"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         SpellCheck.IsEnabled="False"
                         CaretBrush="{DynamicResource Text.Primary}"/>

                <!-- 结果区（只读） -->
                <TextBox x:Name="ResultBox" Grid.Row="3"
                         Height="150"
                         Margin="0,6,0,0"
                         FontFamily="Consolas"
                         FontSize="{DynamicResource Font.Base}"
                         Foreground="{DynamicResource Text.Primary}"
                         BorderThickness="1"
                         Padding="8,6"
                         AcceptsReturn="True"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         CaretBrush="{DynamicResource Text.Primary}"/>

                <!-- 状态栏：左 = 处理状态/默认提示；右 = 操作键帽（可点呼出动作面板） -->
                <Grid Grid.Row="4" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0"
                               Text="Ctrl+Enter 操作 · Esc 返回启动器"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource Font.Secondary}"
                               Foreground="{DynamicResource Text.Placeholder}"
                               TextTrimming="CharacterEllipsis"/>
                    <Border x:Name="ActionsHint" Grid.Column="1"
                            Background="{DynamicResource Bg.ItemHover}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="8,3" Margin="8,0,0,0" Cursor="Hand">
                        <TextBlock Text="操作 Ctrl+Enter"
                                   FontSize="{DynamicResource Font.Secondary}"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                    </Border>
                </Grid>

                <!-- 动作面板（独立浮层组件） -->
                <views:ActionPanel x:Name="Actions"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
