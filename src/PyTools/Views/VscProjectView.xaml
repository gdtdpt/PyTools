<UserControl x:Class="PyTools.Views.VscProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:PyTools.Core"
             xmlns:views="clr-namespace:PyTools.Views">
    <!-- VSCode 最近项目视图（M4）：与剪贴板视图共用呼出壳（切 Content）、令牌与行样式。
         空查询 = 显示全部项目（同剪贴板语义）；动作面板走 Views/ActionPanel 组件。 -->
    <UserControl.Resources>
        <core:EmptyToVisibilityConverter x:Key="EmptyToVisible"/>
    </UserControl.Resources>
    <Border x:Name="RootBorder"
            Background="{DynamicResource Bg.Window}"
            BorderBrush="{DynamicResource Border.Window}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Window}"
            Effect="{DynamicResource Fx.WindowShadow}">
        <Grid x:Name="ContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource Bg.Input}"
                    BorderBrush="{DynamicResource Border.Input}"
                    BorderThickness="0,0,0,1"
                    Padding="{DynamicResource Layout.SearchPadding}">
                <Grid>
                    <TextBox x:Name="PART_SearchBox"
                             Height="{DynamicResource Layout.SearchBoxHeight}"
                             FontSize="{DynamicResource Font.Base}"
                             Foreground="{DynamicResource Text.Primary}"
                             CaretBrush="{DynamicResource Text.Primary}"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="PART_Placeholder"
                               Text="搜索 VSCode 项目…"
                               Margin="2,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource Text.Placeholder}"
                               FontSize="{DynamicResource Font.Base}"
                               Visibility="{Binding Text, ElementName=PART_SearchBox, Converter={StaticResource EmptyToVisible}}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" x:Name="ListArea">
                <ListBox x:Name="PART_List"
                         MaxHeight="{DynamicResource Layout.ListMaxHeight}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,2,0,4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         SelectionMode="Single">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                CornerRadius="{DynamicResource Radius.Control}"
                                                Margin="{DynamicResource Layout.ItemMargin}"
                                                Padding="0">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.ItemHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.ItemSelected}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="{DynamicResource Layout.ItemHeight}" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 角标：锚定可视区，滚动后对可见行重编号（与其它列表同一条规则） -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Badge}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text.Placeholder}"
                                           FontSize="{DynamicResource Font.Secondary}"/>
                                <!-- 项目无图标资源：首字母占位块（与剪贴板文本记录同款）；左对齐拉开与文字间距 -->
                                <Border Grid.Column="1"
                                        Width="28" Height="28"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        CornerRadius="{DynamicResource Radius.Control}"
                                        Background="{DynamicResource Bg.ItemHover}">
                                    <TextBlock Text="{Binding Glyph}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource Font.Secondary}"
                                               Foreground="{DynamicResource Text.Secondary}"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="{DynamicResource Font.Base}"
                                               Foreground="{DynamicResource Text.Primary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="{DynamicResource Font.Secondary}"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyHint"
                           Text="暂无 VSCode 最近项目"
                           Margin="0,14"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Text.Secondary}"
                           FontSize="{DynamicResource Font.Secondary}"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- 底部提示条：左「打开 ↵」右「操作 Ctrl+Enter」（键帽可点，鼠标呼出动作面板） -->
            <Border x:Name="HintBar"
                    Grid.Row="2"
                    Background="{DynamicResource Bg.Input}"
                    BorderBrush="{DynamicResource Border.Input}"
                    BorderThickness="0,1,0,0"
                    Padding="12,5"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="打开"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   FontSize="{DynamicResource Font.Secondary}"/>
                        <Border VerticalAlignment="Center"
                                Margin="6,0,0,0"
                                Background="{DynamicResource Bg.ItemHover}"
                                BorderBrush="{DynamicResource Border.Input}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5,0">
                            <TextBlock Text="↵"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       FontSize="{DynamicResource Font.Secondary}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="ActionsHint"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Cursor="Hand"
                                Background="Transparent">
                        <TextBlock Text="操作"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   FontSize="{DynamicResource Font.Secondary}"/>
                        <Border VerticalAlignment="Center"
                                Margin="6,0,0,0"
                                Background="{DynamicResource Bg.ItemHover}"
                                BorderBrush="{DynamicResource Border.Input}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5,0">
                            <TextBlock Text="Ctrl+Enter"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       FontSize="{DynamicResource Font.Secondary}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 动作面板（独立浮层组件）：贴右下角，可伸出窗外，上限 5 行 -->
            <views:ActionPanel x:Name="Actions"/>

            <!-- toast：底部浮层（打开失败等提示） -->
            <Border x:Name="Toast"
                    Grid.Row="0" Grid.RowSpan="3"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12"
                    Background="{DynamicResource Bg.Toast}"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Padding="14,8"
                    Visibility="Collapsed">
                <TextBlock x:Name="ToastText"
                           Foreground="{DynamicResource Text.OnToast}"
                           FontSize="{DynamicResource Font.Secondary}"
                           MaxWidth="480"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
