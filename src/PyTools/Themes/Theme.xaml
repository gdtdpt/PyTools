<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      基础令牌层（v1 design-system 六维度映射）。
      简洁模式（Theme.Lite.xaml）只允许覆盖三类：窗口底视觉 / 阴影 / 动效，其余令牌两形态强制同值。
    -->

    <!-- 颜色 -->
    <SolidColorBrush x:Key="Bg.Window" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="Bg.Input" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Bg.ItemHover" Color="#EEF1F6"/>
    <SolidColorBrush x:Key="Bg.ItemSelected" Color="#E3EAFB"/>
    <SolidColorBrush x:Key="Border.Window" Color="#E2E5EA"/>
    <SolidColorBrush x:Key="Border.Input" Color="#E2E5EA"/>
    <SolidColorBrush x:Key="Text.Primary" Color="#1F2328"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#6E7681"/>
    <SolidColorBrush x:Key="Text.Placeholder" Color="#9EA0A4"/>
    <SolidColorBrush x:Key="Accent" Color="#2F6BED"/>

    <!-- 字号 -->
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Font.Base">14</system:Double>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Font.Secondary">12</system:Double>

    <!-- 圆角（窗体圆角在简洁模式下被覆盖为 0；控件圆角两形态一致） -->
    <CornerRadius x:Key="Radius.Window">8</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>

    <!-- 阴影（简洁模式覆盖为无效果） -->
    <DropShadowEffect x:Key="Fx.WindowShadow" BlurRadius="28" ShadowDepth="6" Direction="315" Opacity="0.32"/>

    <!-- 动效（毫秒；简洁模式覆盖为 0 = 直切） -->
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Motion.SummonMs">130</system:Double>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Motion.HideMs">100</system:Double>

    <!-- 布局 -->
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Layout.SearchBoxHeight">42</system:Double>
    <Thickness x:Key="Layout.SearchPadding">14,0,14,0</Thickness>
</ResourceDictionary>
