<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      基础令牌层（v1 design-system 六维度映射）。
      简洁模式（Theme.Lite.xaml）只允许覆盖三类：窗口底视觉 / 阴影 / 动效，其余令牌两形态强制同值。
    -->

    <!-- 颜色 -->
    <SolidColorBrush x:Key="Bg.Window" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="Bg.Input" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Bg.ItemHover" Color="#EEF1F6"/>
    <SolidColorBrush x:Key="Bg.ItemSelected" Color="#E3EAFB"/>
    <SolidColorBrush x:Key="Border.Window" Color="#E2E5EA"/>
    <SolidColorBrush x:Key="Border.Input" Color="#E2E5EA"/>
    <SolidColorBrush x:Key="Border.Scrollbar" Color="#D6DAE1"/>
    <SolidColorBrush x:Key="Text.Primary" Color="#1F2328"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#6E7681"/>
    <SolidColorBrush x:Key="Text.Placeholder" Color="#9EA0A4"/>
    <SolidColorBrush x:Key="Accent" Color="#2F6BED"/>
    <SolidColorBrush x:Key="Bg.Toast" Color="#323A48"/>
    <SolidColorBrush x:Key="Text.OnToast" Color="#FFFFFF"/>

    <!-- 字号 -->
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Font.Base">14</system:Double>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Font.Secondary">12</system:Double>

    <!-- 圆角（窗体圆角在简洁模式下被覆盖为 0；控件圆角两形态一致） -->
    <CornerRadius x:Key="Radius.Window">8</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>

    <!-- 阴影（简洁模式覆盖为无效果） -->
    <DropShadowEffect x:Key="Fx.WindowShadow" BlurRadius="28" ShadowDepth="6" Direction="315" Opacity="0.32"/>

    <!-- 动效（毫秒；简洁模式覆盖为 0 = 直切） -->
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Motion.SummonMs">130</system:Double>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Motion.HideMs">100</system:Double>

    <!-- 布局 -->
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Layout.SearchBoxHeight">42</system:Double>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Layout.ItemHeight">48</system:Double>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Layout.ListMaxHeight">480</system:Double>
    <Thickness x:Key="Layout.SearchPadding">14,0,14,0</Thickness>
    <Thickness x:Key="Layout.ItemMargin">8,2,8,2</Thickness>

    <!-- 滚动条：紧凑细轨（拇指可视 4px 两侧内收、无箭头），隐式样式全应用统一（主列表 / 动作面板 / 设置窗口列表） -->
    <Style TargetType="{x:Type ScrollBar}">
        <!-- MinWidth/MinHeight 必须显式压掉主题默认样式的 17（theme 层 setter 高于我们的 Width，不压则实际宽度恒 17） -->
        <Setter Property="MinWidth" Value="4"/>
        <Setter Property="MinHeight" Value="4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="ThumbBd"
                                                    Background="{DynamicResource Border.Scrollbar}"
                                                    Width="4"
                                                    HorizontalAlignment="Center"
                                                    CornerRadius="2"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource Text.Placeholder}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                    <Border x:Name="ThumbBd"
                                                            Background="{DynamicResource Border.Scrollbar}"
                                                            Height="4"
                                                            VerticalAlignment="Center"
                                                            CornerRadius="2"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource Text.Placeholder}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
