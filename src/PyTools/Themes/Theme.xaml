<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      基础令牌层（v1 design-system 六维度映射）。
      简洁模式（Theme.Lite.xaml）只允许覆盖三类：窗口底视觉 / 阴影 / 动效，其余令牌两形态强制同值。
    -->

    <!-- 颜色 -->
    <SolidColorBrush x:Key="Bg.Window" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="Bg.Input" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Bg.ItemHover" Color="#EEF1F6"/>
    <SolidColorBrush x:Key="Bg.ItemSelected" Color="#E3EAFB"/>
    <SolidColorBrush x:Key="Border.Window" Color="#E2E5EA"/>
    <SolidColorBrush x:Key="Border.Input" Color="#E2E5EA"/>
    <SolidColorBrush x:Key="Border.Scrollbar" Color="#D6DAE1"/>
    <SolidColorBrush x:Key="Text.Primary" Color="#1F2328"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#6E7681"/>
    <SolidColorBrush x:Key="Text.Placeholder" Color="#9EA0A4"/>
    <SolidColorBrush x:Key="Accent" Color="#2F6BED"/>
    <SolidColorBrush x:Key="Text.Success" Color="#1A7F37"/>
    <SolidColorBrush x:Key="Text.Error" Color="#CF222E"/>
    <SolidColorBrush x:Key="Bg.Toast" Color="#323A48"/>
    <SolidColorBrush x:Key="Text.OnToast" Color="#FFFFFF"/>

    <!-- 控件态令牌（2026-11-03 控件规范化）：只补交互态缺口，不动既有色值 -->
    <SolidColorBrush x:Key="Border.Hover" Color="#C9D4EA"/>    <!-- 输入类 hover 边框（带一点蓝的灰）-->
    <SolidColorBrush x:Key="Accent.Hover" Color="#4A7EF0"/>    <!-- Accent 按钮悬停（亮一档）-->
    <SolidColorBrush x:Key="Accent.Pressed" Color="#2258C7"/>  <!-- Accent 按钮按下 -->
    <SolidColorBrush x:Key="Accent.Soft" Color="#E3EAFB"/>     <!-- Accent 淡底：单选选中 / 主按钮禁用 -->
    <SolidColorBrush x:Key="Bg.Disabled" Color="#F2F3F5"/>     <!-- 禁用底 -->
    <SolidColorBrush x:Key="Text.Disabled" Color="#9EA0A4"/>   <!-- 禁用文字（与 Placeholder 同值，语义分离）-->
    <SolidColorBrush x:Key="Text.OnAccentDisabled" Color="#9DB4EE"/> <!-- 主按钮禁用时压在淡蓝底上的文字 -->

    <!-- 差异对比配色（text-diff；v1 的 rgba 半透明底色预混成不透明实色，暗色主题只需换本组） -->
    <SolidColorBrush x:Key="Diff.Add.Bg" Color="#DDF0E0"/>        <!-- 增行（绿底，v1 rgba(68,174,86,.18)）-->
    <SolidColorBrush x:Key="Diff.Del.Bg" Color="#F9E0E0"/>        <!-- 删行（红底，v1 rgba(224,85,85,.18)）-->
    <SolidColorBrush x:Key="Diff.Gap.Bg" Color="#FCF1F1"/>        <!-- 对面空档（淡红，v1 rgba(224,85,85,.08)）-->
    <SolidColorBrush x:Key="Diff.Inline.Add" Color="#BDE3C4"/>    <!-- 行内增段（v1 rgba(68,174,86,.35)）-->
    <SolidColorBrush x:Key="Diff.Inline.Del" Color="#F4C4C4"/>    <!-- 行内删段（v1 rgba(224,85,85,.35)）-->
    <SolidColorBrush x:Key="Diff.Gutter.Bg" Color="#F4F5F7"/>     <!-- 行号列底 -->
    <SolidColorBrush x:Key="Diff.Gutter.Equal" Color="#D6DAE1"/>  <!-- 行号列左缘状态条：无差异 -->
    <SolidColorBrush x:Key="Diff.Marker.Changed" Color="#BA7517"/> <!-- 行号列左缘状态条：修改行 -->
    <SolidColorBrush x:Key="Diff.Inline.Add.Focus" Color="#A9DFBA"/> <!-- 行内增段聚焦加深（F3 命中行）-->
    <SolidColorBrush x:Key="Diff.Inline.Del.Focus" Color="#EFABAB"/> <!-- 行内删段聚焦加深 -->
    <SolidColorBrush x:Key="Diff.Invisible" Color="#B8BFC9"/>     <!-- 不可见字符竖条标识（零宽空格等，0 宽渲染不可见故以光标大小色条占位）-->
    <SolidColorBrush x:Key="Diff.Focus.Bg" Color="#FFF6D9"/>      <!-- 跳转命中行整行淡黄底（取代该行增/删底色，行内红绿片段仍指向差异方向）-->

    <!-- 字号 -->
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Font.Base">14</system:Double>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Font.Secondary">12</system:Double>

    <!-- 圆角（窗体圆角在简洁模式下被覆盖为 0；控件圆角两形态一致） -->
    <CornerRadius x:Key="Radius.Window">8</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>

    <!-- 阴影（简洁模式覆盖为无效果） -->
    <DropShadowEffect x:Key="Fx.WindowShadow" BlurRadius="28" ShadowDepth="6" Direction="315" Opacity="0.32"/>

    <!-- 动效（毫秒；简洁模式覆盖为 0 = 直切） -->
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Motion.SummonMs">130</system:Double>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Motion.HideMs">100</system:Double>
    <!-- 工具固定尺寸模式的窗口尺寸过渡（cron 首用）；参数与 v1 animateBounds 一致 -->
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Motion.ToolResizeMs">180</system:Double>

    <!-- 布局 -->
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Layout.SearchBoxHeight">42</system:Double>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Layout.ItemHeight">48</system:Double>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Layout.ListMaxHeight">480</system:Double>
    <Thickness x:Key="Layout.SearchPadding">14,0,14,0</Thickness>
    <Thickness x:Key="Layout.ItemMargin">8,2,8,2</Thickness>
    <!-- 控件标准高：按钮 / 输入框 / 胶囊单选 / 下拉 / 切换块统一（工具面板与设置窗口同值） -->
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Layout.ControlHeight">26</system:Double>
    <!-- 胶囊单选横向内边距 -->
    <Thickness x:Key="Layout.ChipPadding">12,0,12,0</Thickness>

    <!-- 滚动条：紧凑细轨（拇指可视 4px 两侧内收、无箭头），隐式样式全应用统一（主列表 / 动作面板 / 设置窗口列表） -->
    <Style TargetType="{x:Type ScrollBar}">
        <!-- MinWidth/MinHeight 必须显式压掉主题默认样式的 17（theme 层 setter 高于我们的 Width，不压则实际宽度恒 17） -->
        <Setter Property="MinWidth" Value="4"/>
        <Setter Property="MinHeight" Value="4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="ThumbBd"
                                                    Background="{DynamicResource Border.Scrollbar}"
                                                    Width="4"
                                                    HorizontalAlignment="Center"
                                                    CornerRadius="2"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource Text.Placeholder}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                    <Border x:Name="ThumbBd"
                                                            Background="{DynamicResource Border.Scrollbar}"
                                                            Height="4"
                                                            VerticalAlignment="Center"
                                                            CornerRadius="2"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource Text.Placeholder}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
