<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      控件样式库（2026-11-03 控件规范化，用户验收口径：单选 = 淡蓝底 + 蓝字）。
      全部为隐式样式（只写 TargetType，不写 x:Key），由 App.ApplyTheme 与 Theme.xaml 一起合并进应用级资源：
      任何 XAML 里不写 Style 的 Button / TextBox / RadioButton / CheckBox / ComboBox / ToggleButton 自动生效，
      cron 代码后置 new ComboBox() / new TextBox() 同样吃到。特殊形态用具名样式（AccentButton）显式引用。
      约定：交互态颜色一律走令牌（Border.Hover / Accent.Hover / Accent.Pressed / Accent.Soft / Bg.Disabled），
      视图里不要再写局部 Background / BorderBrush / Foreground —— 局部值会压过样式触发器，hover/pressed 会失效。
    -->

    <!-- ============ Button：白底 1px 边框 6px 圆角 高 26 ============ -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight}"/>
        <Setter Property="Padding" Value="12,0,12,0"/>
        <Setter Property="Background" Value="{DynamicResource Bg.Input}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Input}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Secondary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Bg.ItemHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Bg.ItemSelected}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Bg.Disabled}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Border.Input}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 主操作按钮（蓝底白字）：面板里唯一主操作用，显式 Style="{StaticResource AccentButton}" -->
    <Style x:Key="AccentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.OnToast}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Accent.Hover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent.Hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Accent.Pressed}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent.Pressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Accent.Soft}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent.Soft}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.OnAccentDisabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ RadioButton：胶囊化（去圆圈），选中 = 淡蓝底 + Accent 描边 + 蓝字 ============ -->
    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight}"/>
        <Setter Property="Padding" Value="{DynamicResource Layout.ChipPadding}"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource Bg.Input}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Input}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Secondary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- 顺序有意义：hover 在前、选中在后 —— 选中项悬停仍保持淡蓝底 -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Bg.ItemHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Border.Hover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Accent.Soft}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Bg.Disabled}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Border.Input}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ ToggleButton：数值网格用，选中与单选同语义（淡蓝底 + 蓝字） ============ -->
    <Style TargetType="{x:Type ToggleButton}">
        <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight}"/>
        <Setter Property="MinWidth" Value="34"/>
        <Setter Property="Padding" Value="8,0,8,0"/>
        <Setter Property="Background" Value="{DynamicResource Bg.Input}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Input}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Secondary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Bg.ItemHover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Accent.Soft}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Bg.Disabled}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ TextBox：白底 1px 边框，hover 边框偏蓝、focus 边框 Accent ============ -->
    <!-- 不设 Height（多行编辑区按需自定）；不设 VerticalContentAlignment（默认 Top，多行编辑区内容顶对齐，
         单行框各自局部设 Center）；搜索框这类「透明无边框」沿用局部 Background/BorderThickness=0 与
         Padding="0"（占位符 Margin=2 对应默认模板的固有偏移本身；样式默认的 8 会推开文字，补 2 也会
         因 ScrollViewer Margin 与模板固有偏移叠加而让光标穿进首字），边框触发只改 BorderBrush，
         厚度 0 时自然不可见，不会破坏主搜索栏视觉。
         对齐约定（2026-11-03 用户口径）：输入框一律左对齐，只有「定宽窄值框」（如 cron 的秒/分步长、
         区间起止这类三五个字符宽的数值框）才局部设 TextAlignment=Center —— 中心对齐是窄值框的特例，
         不要外溢到普通文本输入。 -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Padding" Value="8,0,8,0"/>
        <Setter Property="TextAlignment" Value="Left"/>
        <Setter Property="Background" Value="{DynamicResource Bg.Input}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Input}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Secondary}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 默认 VerticalContentAlignment=Top（多行编辑区未局部设对齐）时让内容宿主纵向撑满：
                             横向滚动条贴框底。否则 ScrollViewer 按内容收缩，超长单行的滚动条悬在首行下方
                             （2026-11-06 用户截图反馈）。局部设 Center 的单行框不受影响。 -->
                        <Trigger Property="VerticalContentAlignment" Value="Top">
                            <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Stretch"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Border.Hover}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Bg.Disabled}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ CheckBox：15×15 圆角 4 方框，选中 = Accent 实底白勾 ============ -->
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Secondary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="15" Height="15"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Bg.Input}"
                                BorderBrush="{DynamicResource Border.Input}"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Check"
                                  Data="M1,4 L3.4,6.4 L8,1"
                                  Stroke="{DynamicResource Text.OnToast}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="7,0,0,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Border.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Bg.Disabled}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Border.Input}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ ComboBox：全套重模板（白底 / 6px 圆角 / 自绘箭头 / 浮层下拉） ============ -->
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight}"/>
        <Setter Property="Padding" Value="8,0,26,0"/>
        <Setter Property="Background" Value="{DynamicResource Bg.Input}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Input}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Secondary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <!-- 底层：整块可点区域（Style 置空，避免吃到 ToggleButton 隐式样式） -->
                        <ToggleButton x:Name="Face"
                                      Style="{x:Null}"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border x:Name="FaceBd"
                                            Background="{DynamicResource Bg.Input}"
                                            BorderBrush="{DynamicResource Border.Input}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource Radius.Control}"
                                            SnapsToDevicePixels="True"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="FaceBd" Property="BorderBrush" Value="{DynamicResource Border.Hover}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="FaceBd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- 选中项文本（不参与命中测试，点击穿透到 Face） -->
                        <ContentPresenter x:Name="Selection"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          IsHitTestVisible="False"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>

                        <!-- 自绘箭头 -->
                        <Path Data="M0,0 L4,4 L8,0"
                              Stroke="{DynamicResource Text.Secondary}"
                              StrokeThickness="1.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,9,1"
                              IsHitTestVisible="False"/>

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Focusable="False"
                               PopupAnimation="Fade"
                               StaysOpen="False"
                               VerticalOffset="-3"
                               HorizontalOffset="-8">
                            <Grid Margin="8,3,8,10">
                                <Border Background="{DynamicResource Bg.Input}"
                                        BorderBrush="{DynamicResource Border.Input}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Control}"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Effect="{DynamicResource Fx.WindowShadow}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="3"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 下拉项：高 24 / 圆角 4 / hover 灰 / 选中淡蓝底蓝字 -->
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="8,0,8,0"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Secondary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.ItemHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent.Soft}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
