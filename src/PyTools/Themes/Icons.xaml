<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      内置工具矢量图标（2026-11-06，M4 工具入口图标化）：24×24 视框线稿，键名 Icon.<Id> 与
      BuiltinCommand.IconKey 一一对应（selftest 有全覆盖校验）。只用几何形状，颜色由模板
      Path.Stroke 走 DynamicResource（Text.Secondary），深浅主题无需两套。
      「工具列表」入口本身无图标：列表行走首字头像回退。
    -->

    <!-- VSCode 项目：尖括号 </> -->
    <StreamGeometry x:Key="Icon.Vsc">M8.5,6 L3.5,12 L8.5,18 M15.5,6 L20.5,12 L15.5,18</StreamGeometry>

    <!-- 剪贴板记录：夹板 + 顶部夹子 -->
    <StreamGeometry x:Key="Icon.Clipboard">M9,4.5 L6.5,4.5 A1.5,1.5 0 0,0 5,6 L5,19 A1.5,1.5 0 0,0 6.5,20.5 L17.5,20.5 A1.5,1.5 0 0,0 19,19 L19,6 A1.5,1.5 0 0,0 17.5,4.5 L15,4.5 M9,3 L15,3 L15,6 L9,6 Z</StreamGeometry>

    <!-- 格式化：花括号 {} -->
    <StreamGeometry x:Key="Icon.Format">M9,4.5 C7.5,4.5 7.5,6.5 7.5,8 C7.5,9.5 6.5,10.5 5.5,12 C6.5,13.5 7.5,14.5 7.5,16 C7.5,17.5 7.5,19.5 9,19.5 M15,4.5 C16.5,4.5 16.5,6.5 16.5,8 C16.5,9.5 17.5,10.5 18.5,12 C17.5,13.5 16.5,14.5 16.5,16 C16.5,17.5 16.5,19.5 15,19.5</StreamGeometry>

    <!-- 编码转换：上下两行反向箭头 -->
    <StreamGeometry x:Key="Icon.Encode">M4,8 L16.5,8 M13.5,4.5 L17,8 L13.5,11.5 M20,16 L7.5,16 M10.5,12.5 L7,16 L10.5,19.5</StreamGeometry>

    <!-- Cron 表达式：时钟 -->
    <StreamGeometry x:Key="Icon.Cron">M4,12 A8,8 0 1,0 20,12 A8,8 0 1,0 4,12 Z M12,8 L12,12.5 L15,14.5</StreamGeometry>

    <!-- 正则测试：星号 .* -->
    <StreamGeometry x:Key="Icon.Regex">M14,5 L14,15 M9.8,7.5 L18.2,12.5 M18.2,7.5 L9.8,12.5 M6,17.9 A1.6,1.6 0 1,0 9.2,17.9 A1.6,1.6 0 1,0 6,17.9 Z</StreamGeometry>

    <!-- 文件差异对比：双栏，右栏差异行 -->
    <StreamGeometry x:Key="Icon.Diff">M4.5,5 L10.5,5 L10.5,19 L4.5,19 Z M13.5,5 L19.5,5 L19.5,19 L13.5,19 Z M15.5,9.5 L18,9.5 M15.5,12.5 L18,12.5</StreamGeometry>

    <!-- 图片文字识别：取景框 + 山形 + 光点 -->
    <StreamGeometry x:Key="Icon.Ocr">M4,5 L20,5 L20,19 L4,19 Z M6.5,15.5 L10,10.5 L12.5,13.5 L14.5,11.5 L17.5,15.5 M15,6.8 A1.2,1.2 0 1,0 17.4,6.8 A1.2,1.2 0 1,0 15,6.8 Z</StreamGeometry>

    <!-- AI 翻译：字母 A + 「中」字意象（两横一竖） -->
    <StreamGeometry x:Key="Icon.Translate">M4,16 L7.5,7.5 L11,16 M5.5,13.2 L9.5,13.2 M14.5,8 L21,8 M14.5,12 L21,12 M17.75,6 L17.75,14</StreamGeometry>

    <!-- 代码命名：标签牌 + 锚孔 -->
    <StreamGeometry x:Key="Icon.Naming">M4,5.5 L12.5,5.5 L20,12.5 L12.5,19.5 L4,19.5 Z M6.6,8.2 A1.4,1.4 0 1,0 9.4,8.2 A1.4,1.4 0 1,0 6.6,8.2 Z</StreamGeometry>

    <!-- 格式化剪贴板（动作）：夹板 + 内部花括号 -->
    <StreamGeometry x:Key="Icon.FormatClipboard">M9,4.5 L6.5,4.5 A1.5,1.5 0 0,0 5,6 L5,19 A1.5,1.5 0 0,0 6.5,20.5 L17.5,20.5 A1.5,1.5 0 0,0 19,19 L19,6 A1.5,1.5 0 0,0 17.5,4.5 L15,4.5 M9,3 L15,3 L15,6 L9,6 Z M10.5,9.5 C9.8,9.5 9.8,10.5 9.8,11.5 C9.8,12.5 9.3,13 8.8,13.5 C9.3,14 9.8,14.5 9.8,15.5 C9.8,16.5 9.8,17.5 10.5,17.5 M13.5,9.5 C14.2,9.5 14.2,10.5 14.2,11.5 C14.2,12.5 14.7,13 15.2,13.5 C14.7,14 14.2,14.5 14.2,15.5 C14.2,16.5 14.2,17.5 13.5,17.5</StreamGeometry>
</ResourceDictionary>
